# Copy to .env, then run ./scripts/install.sh to fill in the secrets.
#
#   cp .env.example .env
#   ./scripts/install.sh
#   docker compose up -d
#
# This file is the entire configuration surface of the deployment. Together with
# a volume backup it is everything needed to rebuild the stack on a new server.
# Never commit .env.

# --- Application -------------------------------------------------------------
APP_ENV=production
APP_NAME=ShortURL

# The hostname serving the dashboard and the API. Its DNS A/AAAA record must
# already point at this server before `docker compose up`, or the Let's Encrypt
# HTTP challenge cannot complete.
APP_DOMAIN=short.example.com
APP_URL=https://short.example.com

LOG_LEVEL=info

# --- TLS ---------------------------------------------------------------------
# Let's Encrypt sends expiry warnings here.
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_LOG_LEVEL=INFO

# Point at the staging CA while testing a new deployment: its rate limits are
# far higher, at the cost of certificates browsers do not trust.
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=shorturl
POSTGRES_USER=shorturl
# Generated by scripts/install.sh.
POSTGRES_PASSWORD=

# Leave empty to use the bundled Postgres container. Set it only to point at an
# external or managed database, in which case the values above are ignored.
DATABASE_URL=

# --- Redis -------------------------------------------------------------------
# Generated by scripts/install.sh. Required: the container refuses to start
# without it.
REDIS_PASSWORD=

# --- Secrets -----------------------------------------------------------------
# Generated by scripts/install.sh. Rotating SESSION_SECRET logs every user out.
# Rotating IP_HASH_SECRET makes existing anonymised click IPs uncorrelatable
# with new ones, which is a feature if you want to break that linkage.
SESSION_SECRET=
IP_HASH_SECRET=

# --- Dashboard ---------------------------------------------------------------
# Dashboard and API share one origin, so a relative base needs no per-server
# change. Baked into the bundle at image build time.
NUXT_PUBLIC_API_BASE_URL=/api/v1

# --- Tuning ------------------------------------------------------------------
# All optional; the defaults shown are what the server uses when unset.

# Rate limits, per minute. Auth is per client IP, the public API is per API key,
# redirects are per client IP and deliberately generous.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_REDIRECT_PER_MINUTE=600

# How long a resolved link stays in Redis. Correctness does not depend on this:
# every mutation invalidates the entry explicitly.
CACHE_TTL_MINUTES=60

# How long a dashboard session lasts.
SESSION_TTL_DAYS=30

# Raw click events are pruned after this many days. The analytics rollups are
# never pruned - they are small, and they are what the dashboard reads.
CLICK_RETENTION_DAYS=400
CLICK_BATCH_SIZE=256

# --- Images ------------------------------------------------------------------
# Default to building locally. Set these to a registry path to deploy prebuilt
# images instead, which makes moving servers a pull rather than a rebuild:
#   SERVER_IMAGE=ghcr.io/you/shorturl-server:1.0.0
SERVER_IMAGE=
WEB_IMAGE=
VERSION=dev

# --- Development only --------------------------------------------------------
# Loopback ports published by docker-compose.dev.yml. Ignored in production.
POSTGRES_PORT=5432
REDIS_PORT=6379
